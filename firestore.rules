rules_version = '2';
// Caledonite: only the two people listed in the household can read or write, and each of you
// can only change your own record. The calendar sync script writes the calendar copies with a
// service account, which these rules don't apply to.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function household() { return get(/databases/$(database)/documents/households/main).data; }
    function member() { return signedIn() && myEmail() in household().emails; }
    function personEmail(pid) { return get(/databases/$(database)/documents/households/main/people/$(pid)).data.email.lower(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /households/main {
      allow read: if signedIn() && (resource == null || myEmail() in resource.data.emails);
      allow create: if signedIn() && myEmail() in request.resource.data.emails && request.resource.data.emails.size() <= 2;
      // the sync's addresses and secret are set by the script; the two emails are fixed once you've both joined
      allow update: if member()
        && request.resource.data.emails.size() <= 2 && myEmail() in request.resource.data.emails
        && !changed().hasAny(['pingSecret', 'pingUrl', 'scriptUrl', 'connectUrl', 'linked'])
        && (!changed().hasAny(['emails']) || resource.data.get('emailsLocked', false) != true)
        && (!changed().hasAny(['emailsLocked']) || request.resource.data.emailsLocked == true);
      allow delete: if false;

      // each person's own full calendar copy
      match /privateFeeds/{id} {
        allow read: if member() && resource.data.ownerEmail == myEmail();
        allow write: if false;
      }
      // the privacy-filtered copy the partner sees
      match /sharedFeeds/{id} {
        allow read: if member();
        allow write: if false;
      }
      match /status/{id} {
        allow read: if member();
        allow write: if false;
      }
      match /calendars/{id} {
        allow read: if member();
        // only the owner of a calendar decides what's shared from it, and only that: whose it is and which
        // calendar it points at are the sync's (changing them could share someone else's calendar)
        allow update: if member() && personEmail(resource.data.owner) == myEmail()
          && changed().hasOnly(['show', 'share', 'role', 'layer', 'userSet'])
          && request.resource.data.get('share', 'busy') in ['all', 'busy', 'none', 'hours'];
        allow create, delete: if false;
      }
      match /people/{pid} {
        allow read: if member();
        // only the two of you, made together with the household (first-time setup). After that no one can add a
        // third record, so no one can make a second "you" whose calendars would be shared again with the defaults.
        allow create: if signedIn()
          && !exists(/databases/$(database)/documents/households/main)
          && myEmail() in getAfter(/databases/$(database)/documents/households/main).data.emails
          && (request.resource.data.get('email', '') == '' || request.resource.data.email.lower() in getAfter(/databases/$(database)/documents/households/main).data.emails)
          && (request.resource.data.get('joined', false) != true || request.resource.data.email.lower() == myEmail());
        // your own record: anything but your email. Your other accounts can't be one of the two main ones.
        // your partner's: only their shift times, and their email until they've joined.
        allow update: if member() && (
          (resource.data.email.lower() == myEmail() && request.resource.data.email == resource.data.email
            && (!changed().hasAny(['linked']) || !request.resource.data.get('linked', []).hasAny(household().emails)))
          || (resource.data.email.lower() != myEmail()
              && changed().hasOnly(['settings', 'email'])
              && (request.resource.data.email == resource.data.email
                  || (resource.data.get('joined', false) != true && household().get('emailsLocked', false) != true))
              && (!changed().hasAny(['settings'])
                  || request.resource.data.get('settings', {}).diff(resource.data.get('settings', {})).affectedKeys().hasOnly(['shiftTypes', 'sleepUntil', 'travelMins'])))
        );
        allow delete: if false;
        // phone notification addresses: only your own
        match /tokens/{t} {
          allow read, write: if member() && personEmail(pid) == myEmail();
        }
        // things just for you (reminders, private countdowns): they can name events you share only as "Busy"
        match /private/{doc} {
          allow read, write: if member() && personEmail(pid) == myEmail();
        }
      }
      // requests: anyone can answer, but who asked, who it's for and whether it's just for one of you are fixed
      // (the calendar sync uses them to decide whether your partner may change the event that came from it)
      match /requests/{id} {
        allow read: if member();
        allow create: if member() && personEmail(request.resource.data.from) == myEmail();
        allow update: if member() && !changed().hasAny(['from', 'to', 'type', 'own', 'people']);
        allow delete: if false;
      }
      // asks to add, change or remove things in Google Calendar: always signed with who asked.
      // Only your own: they can hold the names of things you share with your partner only as "Busy".
      match /outbox/{id} {
        allow read: if member() && resource.data.byEmail == myEmail();
        allow create: if member() && request.resource.data.byEmail == myEmail() && request.resource.data.done == false;
        allow update, delete: if false;
      }
      function okNotify(id) {
        return request.resource.data.sent == false
          && request.resource.data.kind in ['requests', 'rota', 'notes', 'reminders', 'jobs', 'summary', 'test']
          && (request.resource.data.kind != 'test' || personEmail(request.resource.data.to) == myEmail())
          && (!id.matches('pk-.*') || (request.resource.data.kind == 'reminders'
            && request.resource.data.keys().hasOnly(['to', 'kind', 'title', 'body', 'link', 'sendAfter', 'sent', 'created'])));
      }
      // notifications waiting to be sent: write-only. Only the kinds your notification settings know, so turning
      // one off always works; a test (sent straight away, even in quiet hours) only to yourself.
      // Peckish (on the same website) keeps its meal reminders ("pk-..." ids, never used by Caledonite) up to date
      // while they wait: it can check one, change it (still a reminder, for the same person) or take it back,
      // but never one that's been sent.
      match /notify/{id} {
        allow create: if member() && okNotify(id);
        allow get: if member() && id.matches('pk-.*');
        allow update: if member() && id.matches('pk-.*') && resource.data.sent == false
          && okNotify(id) && request.resource.data.to == resource.data.to;
        allow delete: if member() && id.matches('pk-.*') && resource.data.sent == false;
        allow list: if false;
      }
      match /{coll}/{id} {
        allow read, write: if member() && coll in ['notes', 'shifts', 'jobs', 'ideas'];
      }
    }
  }
}
